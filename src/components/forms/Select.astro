---
/**
 * Select - native `<select>` styled to match Field's terminal-line look (prompt glyph, bottom
 * border only), with a plain `▾` glyph in place of the browser's default arrow.
 */
export interface Props {
  name: string;
  label: string;
  options: { value: string; label: string }[];
  value?: string;
  required?: boolean;
  description?: string;
  error?: string;
  disabled?: boolean;
  id?: string;
  class?: string;
}

const {
  name,
  label,
  options,
  value,
  required = false,
  description,
  error,
  disabled = false,
  id,
  class: className,
} = Astro.props;

const fieldId = id ?? `field-${name}`;
const descId = description ? `${fieldId}-desc` : undefined;
const errId = error ? `${fieldId}-err` : undefined;
const describedBy = [descId, errId].filter(Boolean).join(' ') || undefined;
---

<div class:list={['forms-field flex flex-col gap-1', className]}>
  <label for={fieldId} class="font-kode text-t-sm text-terminal-400">
    {label}
    {required && <span class="text-terminal-300"> (required)</span>}
  </label>
  <div class="flex items-center gap-2">
    <span class="font-kode text-terminal-400" aria-hidden="true"> &gt; </span>
    <div class="relative flex-1">
      <select
        id={fieldId}
        name={name}
        required={required}
        disabled={disabled}
        aria-describedby={describedBy}
        aria-invalid={error ? 'true' : undefined}
        class:list={[
          'forms-control w-full appearance-none bg-transparent border-0 border-b py-1.5 pr-6 font-kode text-t-base text-terminal-500',
          'focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed',
          error ? 'border-rose-500/70' : 'border-terminal-300 focus:border-terminal-bright',
        ]}
      >
        {
          options.map((opt) => (
            <option value={opt.value} selected={value !== undefined ? opt.value === value : undefined}>
              {opt.label}
            </option>
          ))
        }
      </select>
      <span
        aria-hidden="true"
        class="pointer-events-none absolute right-1 top-1/2 -translate-y-1/2 font-kode text-terminal-400"
      >
        &#9662;
      </span>
    </div>
  </div>
  {
    description && (
      <p id={descId} class="font-kode text-t-sm text-terminal-300">
        {description}
      </p>
    )
  }
  {
    error && (
      <p id={errId} class="font-kode text-t-sm text-rose-400 flex items-start gap-1">
        <span class="font-bold shrink-0">ERR</span>
        <span>{error}</span>
      </p>
    )
  }
</div>
