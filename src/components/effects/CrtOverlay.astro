---
/**
 * CrtOverlay - the persistent CRT effect layer: static noise, a scanline sweep and a vignette,
 * stacked over the whole viewport with `pointer-events: none` so it never blocks interaction.
 *
 * Replaces `TerminalComponents/TerminalOverlay.astro`. Included once, site-wide, from
 * `Layout.astro`.
 *
 * The three layer class names (`.terminal-overlay .noise|.scanline|.overlay`) are load-bearing:
 * `common/ThemeHead.astro`'s effects-gating CSS hides them via
 * `[data-fx-noise="off"] .terminal-overlay .noise` (and the `scanline`/`overlay` equivalents),
 * plus a `prefers-reduced-motion` rule targeting the same selectors. Renaming any of them means
 * updating that CSS too.
 */
export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['terminal-overlay', className]} aria-hidden="true">
  <div class="noise"></div>
  <div class="scanline"></div>
  <div class="overlay"></div>
</div>

<style>
  .terminal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    pointer-events: none;
  }

  .noise {
    position: absolute;
    inset: 0;
    z-index: 100;
    background-image: url('/images/terminal-static-animated.gif');
    background-repeat: no-repeat;
    background-size: cover;
    opacity: 0.02;
    transition: opacity 0.3s ease;
  }

  .overlay {
    position: absolute;
    inset: 0;
    z-index: 101;
    background: repeating-linear-gradient(180deg, rgba(0, 0, 0, 0) 0, rgba(0, 0, 0, 0.25) 50%, rgba(0, 0, 0, 0) 100%);
    background-size: auto 5px;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .scanline {
    position: absolute;
    inset: 0;
    z-index: 102;
    background-image: linear-gradient(
      0deg,
      transparent 0%,
      var(--terminal-200) 2%,
      var(--terminal-500) 3%,
      var(--terminal-200) 3%,
      transparent 100%
    );
    background-repeat: no-repeat;
    opacity: 0.5;
    animation: crt-overlay-scan 7.5s linear 0s infinite;
    transition: opacity 0.3s ease;
  }

  @keyframes crt-overlay-scan {
    0% {
      background-position: 0 -100vh;
    }
    35%,
    100% {
      background-position: 0 100vh;
    }
  }
</style>
