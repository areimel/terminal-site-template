---
/**
 * Checkbox - `[x]` / `[ ]` glyph rendered in pure CSS (`peer-checked`) over a native checkbox
 * that stays in the accessibility tree and keyboard/focus order (`sr-only`, not `hidden`).
 */
export interface Props {
  name: string;
  label: string;
  value?: string;
  checked?: boolean;
  description?: string;
  disabled?: boolean;
  required?: boolean;
  id?: string;
  class?: string;
}

const {
  name,
  label,
  value,
  checked = false,
  description,
  disabled = false,
  required = false,
  id,
  class: className,
} = Astro.props;

const checkboxId = id ?? `checkbox-${name}`;
const descId = description ? `${checkboxId}-desc` : undefined;

const GLYPH_RING =
  'peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-terminal-bright peer-focus-visible:outline-offset-2 peer-focus-visible:rounded-sm';
---

<div class:list={['forms-field flex flex-col gap-1', className]}>
  <label
    for={checkboxId}
    class:list={[
      'inline-flex items-start gap-2 cursor-pointer font-kode text-t-base text-terminal-400 select-none',
      { 'opacity-50 cursor-not-allowed': disabled },
    ]}
  >
    <input
      type="checkbox"
      id={checkboxId}
      name={name}
      value={value}
      checked={checked}
      disabled={disabled}
      required={required}
      aria-describedby={descId}
      class="peer sr-only"
    />
    <span
      aria-hidden="true"
      class:list={['forms-glyph shrink-0 inline-block w-[3ch] text-terminal-500 peer-checked:hidden', GLYPH_RING]}
    >
      [ ]
    </span>
    <span
      aria-hidden="true"
      class:list={['forms-glyph shrink-0 hidden peer-checked:inline-block w-[3ch] text-terminal-bright', GLYPH_RING]}
    >
      [x]
    </span>
    <span>
      {label}
      {required && <span class="text-terminal-300"> (required)</span>}
    </span>
  </label>
  {
    description && (
      <p id={descId} class="font-kode text-t-sm text-terminal-300 ml-[calc(3ch+0.5rem)]">
        {description}
      </p>
    )
  }
</div>
