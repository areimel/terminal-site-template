---
import { Button, Icon } from '~/components/core';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  prevUrl?: string;
  nextUrl?: string;
  prevText?: string;
  nextText?: string;
}

const { prevUrl, nextUrl, prevText = 'Newer posts', nextText = 'Older posts' } = Astro.props;
---

{
  (prevUrl || nextUrl) && (
    <nav class="mt-10 flex items-center justify-between gap-4" aria-label="Pagination">
      {prevUrl ? (
        <Button href={getPermalink(prevUrl)} variant="outline" size="sm">
          <Icon name="tabler:chevron-left" size={18} />
          {prevText}
        </Button>
      ) : (
        <span aria-hidden="true" />
      )}
      {nextUrl ? (
        <Button href={getPermalink(nextUrl)} variant="outline" size="sm">
          {nextText}
          <Icon name="tabler:chevron-right" size={18} />
        </Button>
      ) : (
        <span aria-hidden="true" />
      )}
    </nav>
  )
}
