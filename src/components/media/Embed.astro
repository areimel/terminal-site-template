---
import Panel from '~/components/core/Panel.astro';

/**
 * Embed - a responsive iframe container styled as a Panel.
 *
 * Renders an iframe with lazy loading and fullscreen support, wrapped in a Panel
 * with a title bar showing the embed name. The aspect ratio keeps the iframe
 * responsive across screen sizes.
 */
export interface Props {
  src: string;
  title: string;
  aspect?: '16/9' | '4/3' | '1/1';
  class?: string;
}

const { src, title, aspect = '16/9', class: className } = Astro.props;

const aspectRatios: Record<string, string> = {
  '16/9': 'aspect-video',
  '4/3': 'aspect-[4/3]',
  '1/1': 'aspect-square',
};
---

<Panel {title} class:list={['media-embed', className]}>
  <div class:list={['media-embed-wrapper', aspectRatios[aspect]]}>
    <iframe src={src} title={title} loading="lazy" allowfullscreen class="media-embed-iframe"></iframe>
  </div>
</Panel>

<style>
  .media-embed {
    width: 100%;
  }

  .media-embed-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--terminal-bg-primary);
  }

  .media-embed-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
</style>
