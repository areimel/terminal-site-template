---
/**
 * Heading - the template's typed heading primitive.
 *
 * Always sets the UAV OSD Mono heading font (`font-uav-mono`). Sizes use the `t-*` type-scale
 * tokens defined in tailwind.config.js.
 *
 * `decode` only marks the element up (`data-decode` + `data-text`) - the `effects/DecoderText`
 * enhancer (owned by another agent) is what actually animates any `[data-decode]` element. This
 * component does not implement that animation.
 */
export interface Props {
  level: 1 | 2 | 3 | 4 | 5 | 6;
  /** Visual size on the same 1-6 scale; defaults to `level`. Keeps semantics and looks independent. */
  size?: 1 | 2 | 3 | 4 | 5 | 6;
  /** Override the rendered tag (e.g. visually an `h2` styled as an `h1`). Defaults to `h{level}`. */
  as?: string;
  /** Prepends a `>` prompt glyph before the heading text. */
  prompt?: boolean;
  /** Marks the element for the DecoderText enhancer; does not animate anything itself. */
  decode?: boolean;
  glow?: 'none' | 'subtle' | 'strong';
  class?: string;
}

const { level, size, as, prompt = false, decode = false, glow = 'none', class: className } = Astro.props;

const Tag = as ?? (`h${level}` as const);

// Sizes use the 1.25 modular type scale tokens from tailwind.config.js.
const SIZE: Record<Props['level'], string> = {
  // Levels 1-2 scale fluidly on phones: the wide display face can't wrap long single words.
  1: 'text-[clamp(1.75rem,8vw,3.0518rem)] leading-tight md:text-t-5xl font-bold tracking-tight',
  2: 'text-[clamp(1.4rem,6.5vw,1.9531rem)] leading-tight md:text-t-3xl font-bold tracking-tight',
  3: 'text-t-xl md:text-t-2xl font-semibold',
  4: 'text-t-lg md:text-t-xl font-semibold',
  5: 'text-t-base md:text-t-lg font-semibold',
  6: 'text-t-base font-semibold',
};

const GLOW: Record<NonNullable<Props['glow']>, string> = {
  none: '',
  subtle: 'text-glow-subtle',
  strong: 'text-glow-strong',
};

// Only render the plain-text slot content into `data-text` when `decode` is on, since it
// requires rendering the slot up front.
const decodeText = decode ? (await Astro.slots.render('default')).replace(/<[^>]*>/g, '').trim() : undefined;
---

<Tag
  class:list={['font-uav-mono [overflow-wrap:anywhere]', SIZE[size ?? level], GLOW[glow], className]}
  data-decode={decode ? '' : undefined}
  data-text={decodeText}
>
  {prompt && <span aria-hidden="true">&gt;_ </span>}
  <slot />
</Tag>
