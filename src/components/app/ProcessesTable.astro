---
/**
 * ProcessesTable - the "Processes" tab panel: a DataTable of fake running processes.
 * Status renders as Badges via the DataTable column `badges` map.
 */
import { DataTable } from '~/components/data';
import type { ProcessRow } from './data';

export interface Props {
  processes: ProcessRow[];
  class?: string;
}

const { processes, class: className } = Astro.props;

const rows = processes.map((p) => ({
  pid: p.pid,
  name: p.name,
  user: p.user,
  cpu: p.cpu,
  mem: p.mem,
  status: p.status,
  started: p.started,
}));
---

<DataTable
  class={className}
  caption="Running processes"
  dense
  stickyHeader
  columns={[
    { key: 'pid', label: 'PID', align: 'right', sortable: true },
    { key: 'name', label: 'Name', sortable: true },
    { key: 'user', label: 'User', sortable: true },
    { key: 'cpu', label: 'CPU %', align: 'right', sortable: true, format: 'number' },
    { key: 'mem', label: 'Mem (MB)', align: 'right', sortable: true, format: 'number' },
    {
      key: 'status',
      label: 'Status',
      sortable: true,
      badges: { RUNNING: 'ok', SLEEPING: 'default', STOPPED: 'err' },
    },
    { key: 'started', label: 'Started', sortable: true },
  ]}
  rows={rows}
/>
