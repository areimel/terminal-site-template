---
/**
 * ArticleShell - shared long-form article layout for blog posts and projects.
 *
 * Renders the header (heading + meta line: date, reading time, category, tags as core
 * `Badge`s), an optional hero image, the article body wrapped in `prose prose-terminal`,
 * and a footer with tags + social share.
 *
 * Slots:
 * - default: the article body (post/project content).
 * - `facts`: optional content rendered between the hero image and the body, e.g. a project's
 *   `ProjectHeader` (technologies, role/client/duration, live + repo links).
 * - `footer`: optional content rendered after tags/share, e.g. prev/next links.
 */
import type { ImageMetadata } from 'astro';

import { Badge, Heading, Icon } from '~/components/core';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
  class?: string;
}

const { post, url, class: className } = Astro.props;

const hasFacts = Astro.slots.has('facts');
const hasFooterExtra = Astro.slots.has('footer');

const image = post.image as ImageMetadata | string | undefined;
const imageSrc = typeof image === 'string' ? image : image?.src;
---

<article class:list={['mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-16', className]}>
  <header class="mb-8">
    <div class="mb-3 flex flex-wrap items-center gap-x-2 gap-y-1.5 font-kode text-t-sm text-terminal-400">
      <Icon name="tabler:clock" size={14} />
      <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
      {
        post.readingTime && (
          <>
            <span aria-hidden="true">·</span>
            <span>{post.readingTime} min read</span>
          </>
        )
      }
      {
        post.category && (
          <>
            <span aria-hidden="true">·</span>
            <a
              href={post.category.permalink ?? getPermalink(post.category.slug, 'category')}
              class="transition-colors hover:text-terminal-bright"
            >
              {post.category.title}
            </a>
          </>
        )
      }
      {
        post.tags && post.tags.length > 0 && (
          <span class="flex flex-wrap gap-1.5">
            {post.tags.map((tag) => (
              <Badge variant="outline">{tag.title}</Badge>
            ))}
          </span>
        )
      }
    </div>

    <Heading level={1} decode glow="subtle" class="mb-4">
      {post.title}
    </Heading>

    {post.excerpt && <p class="text-t-lg text-terminal-400">{post.excerpt}</p>}
  </header>

  {
    imageSrc && (
      <img
        src={imageSrc}
        alt={post.excerpt || post.title}
        class="mb-8 w-full border border-terminal-300/40"
        loading="eager"
        decoding="async"
      />
    )
  }

  {
    hasFacts && (
      <div class="mb-8">
        <slot name="facts" />
      </div>
    )
  }

  <div class="prose prose-terminal max-w-none">
    <slot />
  </div>

  <footer
    class="mt-10 flex flex-col gap-6 border-t border-terminal-300/40 pt-6 sm:flex-row sm:items-center sm:justify-between"
  >
    <PostTags tags={post.tags} />
    <SocialShare url={url} text={post.title} />
  </footer>

  {
    hasFooterExtra && (
      <div class="mt-6">
        <slot name="footer" />
      </div>
    )
  }
</article>
