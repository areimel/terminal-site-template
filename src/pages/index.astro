---
import Layout from '~/layouts/PageLayout.astro';
import { TEMPLATE } from 'astrowind:config';
import { Panel, Heading, Button } from '@components/core';

const metadata = {
  title: TEMPLATE.identity.name,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <div class="w-full max-w-4xl mx-auto py-12 px-4">
    <Panel title="~/home">
      <Heading level={1} class="mb-4">
        {TEMPLATE.identity.name}
      </Heading>
      <p class="text-terminal-400 font-kode text-base mb-6">
        {TEMPLATE.identity.tagline}
      </p>
      <div class="flex gap-3">
        <Button href="/projects">View Projects</Button>
        <Button href="/blog">Read Blog</Button>
      </div>
    </Panel>
  </div>
</Layout>
