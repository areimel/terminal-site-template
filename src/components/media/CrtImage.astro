---
import Image from '~/components/common/Image.astro';
import Prompt from '~/components/core/Prompt.astro';

/**
 * CrtImage - an image rendered with a CRT monitor effect.
 *
 * Applies a CSS-based CRT look: grayscale filter, theme-colored tint overlay,
 * repeating-linear-gradient scanlines, and a subtle vignette. The scanline
 * flicker animation is optional and respects the effects config and reduced-motion.
 */
export interface Props {
  src: string;
  alt: string;
  caption?: string;
  intensity?: 'low' | 'high';
  tint?: boolean;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt,
  caption,
  intensity = 'low',
  tint = true,
  width,
  height,
  loading = 'lazy',
  class: className,
} = Astro.props;
const shouldFlicker = intensity === 'high';
---

<figure class:list={['media-crt-figure', className]}>
  <div class="media-crt-container">
    <div class:list={['media-crt-viewport', { 'media-crt-flicker': shouldFlicker }]}>
      <Image src={src} alt={alt} {width} {height} loading={loading} class="media-crt-img" />
      {tint && <div class="media-crt-tint" aria-hidden="true" />}
      <div class="media-crt-scanlines" aria-hidden="true"></div>
      <div class="media-crt-vignette" aria-hidden="true"></div>
    </div>
  </div>
  {
    caption && (
      <figcaption class="media-crt-caption">
        <Prompt symbol=">" class="media-crt-prompt" />
        <span class="media-crt-text">{caption}</span>
      </figcaption>
    )
  }
</figure>

<style>
  .media-crt-figure {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .media-crt-container {
    position: relative;
    width: 100%;
  }

  .media-crt-viewport {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: auto;
    overflow: hidden;
  }

  .media-crt-img {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(100%);
  }

  .media-crt-tint {
    position: absolute;
    inset: 0;
    background-color: var(--theme-500);
    mix-blend-mode: multiply;
    pointer-events: none;
    opacity: 0.15;
  }

  .media-crt-scanlines {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.15),
      rgba(0, 0, 0, 0.15) 1px,
      transparent 1px,
      transparent 2px
    );
    pointer-events: none;
  }

  .media-crt-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 0%, rgba(0, 0, 0, 0.25) 100%);
    pointer-events: none;
  }

  .media-crt-flicker[data-fx-scanline='on'] {
    animation: media-crt-flicker 0.15s infinite;
  }

  @keyframes media-crt-flicker {
    0%,
    49%,
    100% {
      opacity: 1;
    }
    50%,
    99% {
      opacity: 0.97;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .media-crt-flicker {
      animation: none;
    }
  }

  .media-crt-caption {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--terminal-300);
  }

  .media-crt-prompt {
    flex-shrink: 0;
  }

  .media-crt-text {
    flex: 1;
  }
</style>
