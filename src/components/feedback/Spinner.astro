---
/**
 * Spinner - an ASCII loading indicator. The glyph animates by cycling
 * `content` in a `steps()` CSS animation (no image/SVG asset). Under
 * `prefers-reduced-motion`, the animation stops on a static glyph and the
 * label - normally screen-reader-only - becomes visible too, since a frozen
 * glyph alone no longer communicates "still working" to a sighted user.
 */
export interface Props {
  label?: string;
  style?: 'bar' | 'dots' | 'braille';
  class?: string;
}

const { label = 'Loading', style = 'bar', class: className } = Astro.props;
---

<span
  class:list={['core-spinner inline-flex items-center gap-2 font-kode text-terminal-400', className]}
  role="status"
  data-spinner-style={style}
>
  <span class="core-spinner-glyph" aria-hidden="true"></span>
  <span class="sr-only motion-reduce:not-sr-only">{label}</span>
</span>

<style>
  .core-spinner-glyph::before {
    display: inline-block;
    width: 1.5em;
    text-align: center;
  }

  [data-spinner-style='bar'] .core-spinner-glyph::before {
    content: '|';
    animation: core-spinner-bar 0.8s steps(4) infinite;
  }

  [data-spinner-style='dots'] .core-spinner-glyph::before {
    /* Static (reduced-motion) fallback; the animation overrides this at 0%. */
    content: '...';
    animation: core-spinner-dots 1.2s steps(4) infinite;
  }

  [data-spinner-style='braille'] .core-spinner-glyph::before {
    content: '⠋';
    animation: core-spinner-braille 0.8s steps(10) infinite;
  }

  @keyframes core-spinner-bar {
    0% {
      content: '|';
    }
    25% {
      content: '/';
    }
    50% {
      content: '-';
    }
    75% {
      content: '\\';
    }
    100% {
      content: '|';
    }
  }

  @keyframes core-spinner-dots {
    0% {
      content: '';
    }
    33% {
      content: '.';
    }
    66% {
      content: '..';
    }
    100% {
      content: '...';
    }
  }

  @keyframes core-spinner-braille {
    0% {
      content: '⠋';
    }
    10% {
      content: '⠙';
    }
    20% {
      content: '⠹';
    }
    30% {
      content: '⠸';
    }
    40% {
      content: '⠼';
    }
    50% {
      content: '⠴';
    }
    60% {
      content: '⠦';
    }
    70% {
      content: '⠧';
    }
    80% {
      content: '⠇';
    }
    90% {
      content: '⠏';
    }
    100% {
      content: '⠋';
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .core-spinner-glyph::before {
      animation: none !important;
    }
  }
</style>
