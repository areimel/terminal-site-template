---
import { themes } from '~/lib/themes';
---

<div class="theme-switcher">
  <h3 class="text-terminal-500 text-lg font-bold mb-3">Terminal Theme</h3>

  <div class="flex flex-col gap-2">
    {
      themes.map((theme) => (
        <button
          class="theme-button px-4 py-2 font-uav-mono text-xs transition-colors flex items-center border-2 border-terminal-300 gap-2"
          data-theme={theme.id}
          aria-label={`Switch to ${theme.label} theme`}
        >
          <span class="w-4 h-4 rounded-full" style={`background-color: ${theme.colors[500]}`} />
          {theme.label}
        </button>
      ))
    }
  </div>
</div>

<script>
  import { themes } from '~/lib/themes';
  import { applyTheme, getTheme } from '~/lib/theme-runtime';

  function setActiveButton(id: string) {
    document.querySelectorAll<HTMLButtonElement>('.theme-switcher .theme-button').forEach((button) => {
      button.classList.toggle('active', button.dataset.theme === id);
    });
  }

  function setup() {
    setActiveButton(getTheme());

    document.querySelectorAll<HTMLButtonElement>('.theme-switcher .theme-button').forEach((button) => {
      button.addEventListener('click', () => {
        const id = button.dataset.theme;
        if (id && themes.some((theme) => theme.id === id)) {
          applyTheme(id);
        }
      });
    });
  }

  setup();
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('terminal:theme-change', (event) => {
    const { id } = (event as CustomEvent<{ id: string }>).detail;
    setActiveButton(id);
  });
</script>

<style>
  .theme-button {
    @apply bg-terminal-bg-secondary text-terminal-500 hover:bg-terminal-bg-accent hover:text-terminal-bright hover:border-terminal-bright;
    position: relative;
    overflow: hidden;
  }

  .theme-button.active {
    @apply bg-terminal-bg-accent text-terminal-bright border-terminal-bright;
  }

  .theme-button.active::after {
    content: '';
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    @apply bg-terminal-bright;
    box-shadow: 0 0 5px var(--terminal-bright);
  }
</style>
