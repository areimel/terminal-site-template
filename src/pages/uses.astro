---
import { TEMPLATE } from 'astrowind:config';

import PageLayout from '~/layouts/PageLayout.astro';
import { Heading, Container, Panel } from '~/components/core';
import { KeyValue } from '~/components/data';
import { uses } from '~/data/profile';
import type { MetaData } from '~/types';

const metadata: MetaData = {
  title: 'Uses',
  description: `Hardware, software and services ${TEMPLATE.identity.name} uses day to day.`,
};
---

<PageLayout metadata={metadata}>
  <Container size="prose" spacing="lg">
    <Heading level={1} class="mb-2">Uses</Heading>
    <p class="mb-8 text-terminal-400">
      The hardware, terminal setup and services behind the day-to-day work - the machine, the tools, and what runs the
      sites.
    </p>

    <div class="flex flex-col gap-6">
      {
        uses.map((group) => (
          <Panel title={`~/uses/${group.group.toLowerCase()}.cfg`} variant="line">
            <KeyValue items={group.items.map((item) => ({ key: item.name, value: item.note }))} />
          </Panel>
        ))
      }
    </div>
  </Container>
</PageLayout>
