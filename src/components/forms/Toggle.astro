---
/**
 * Toggle - a `role="switch"` checkbox rendered as `[ON ]` / `[OFF]` (same width, so the label
 * doesn't shift when it flips). Same visually-hidden-but-focusable pattern as Checkbox/Radio.
 */
import type { HTMLAttributes } from 'astro/types';

/** Extra attributes (e.g. `data-*`) are passed through to the underlying `<input>`. */
export interface Props extends Omit<HTMLAttributes<'input'>, 'type' | 'role' | 'class' | 'name' | 'id'> {
  name: string;
  label: string;
  checked?: boolean;
  id?: string;
  description?: string;
  disabled?: boolean;
  class?: string;
}

const { name, label, checked = false, id, description, disabled = false, class: className, ...rest } = Astro.props;

const toggleId = id ?? `toggle-${name}`;
const descId = description ? `${toggleId}-desc` : undefined;

const GLYPH_RING =
  'peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-terminal-bright peer-focus-visible:outline-offset-2 peer-focus-visible:rounded-sm';
---

<div class:list={['forms-field forms-toggle flex flex-col gap-1', className]}>
  <label
    for={toggleId}
    class:list={[
      'inline-flex items-center gap-2 cursor-pointer font-kode text-t-base text-terminal-400 select-none w-fit',
      { 'opacity-50 cursor-not-allowed': disabled },
    ]}
  >
    <input
      {...rest}
      type="checkbox"
      role="switch"
      id={toggleId}
      name={name}
      checked={checked}
      disabled={disabled}
      aria-describedby={descId}
      class="peer sr-only"
    />
    <span
      aria-hidden="true"
      class:list={['forms-glyph inline-block w-[5ch] text-terminal-500 peer-checked:hidden', GLYPH_RING]}
    >
      [OFF]
    </span>
    <span
      aria-hidden="true"
      class:list={['forms-glyph hidden peer-checked:inline-block w-[5ch] text-terminal-bright', GLYPH_RING]}
    >
      [ON ]
    </span>
    <span>{label}</span>
  </label>
  {
    description && (
      <p id={descId} class="font-kode text-t-sm text-terminal-300 ml-[calc(5ch+0.5rem)]">
        {description}
      </p>
    )
  }
</div>

<style>
  /* Reflect runtime disabled changes (e.g. toggled by a script), not just the server-rendered prop. */
  .forms-toggle:has(input:disabled) label {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
