---
import PageLayout from '~/layouts/PageLayout.astro';
import TerminalShell from '~/components/shell/TerminalShell.astro';

const metadata = {
  title: 'Terminal',
  description: 'A full-screen, keyboard-operable shell for exploring the site from the command line.',
};
---

<PageLayout metadata={metadata}>
  <h1 class="sr-only">Terminal</h1>
  <TerminalShell mode="fullscreen" autofocus />
  <Fragment slot="footer"></Fragment>
</PageLayout>
