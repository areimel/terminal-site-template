---
/**
 * SettingsPanel - ThemeSwitcher and EffectsControls grouped under headings, with no modal
 * wrapper of its own. The sidebar's Settings button opens `data-modal-open="settings"`; the lead
 * wraps this panel in `<Modal id="settings">` in PageLayout.
 */
import { Heading, Divider } from '~/components/core';
import ThemeSwitcher from './ThemeSwitcher.astro';
import EffectsControls from './EffectsControls.astro';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['settings-panel flex flex-col gap-6', className]}>
  <section>
    <Heading level={2} class="mb-3">Theme</Heading>
    <ThemeSwitcher />
  </section>

  <Divider style="dashed" />

  <section>
    <Heading level={2} class="mb-3">Effects</Heading>
    <EffectsControls />
  </section>
</div>
