---
import { TEMPLATE } from 'astrowind:config';
import PageLayout from '~/layouts/PageLayout.astro';
import { Container, Heading, Panel } from '~/components/core';
import { ContactForm } from '~/components/forms';
import { KeyValue } from '~/components/data';
import { socialLinks } from '~/navigation';
import type { KeyValueItem } from '~/components/data/KeyValue.astro';

const metadata = {
  title: 'Contact',
  description: `Send a message to ${TEMPLATE.identity.name}, ${TEMPLATE.identity.role} at ${TEMPLATE.identity.org}.`,
};

const socialItems: KeyValueItem[] = socialLinks.map((link) => ({
  key: link.label,
  value: link.href.replace(/^https?:\/\//, ''),
}));
---

<PageLayout metadata={metadata}>
  <Container size="prose">
    <Heading level={1} class="mb-4">Contact</Heading>
    <p class="mb-8 font-kode text-t-base text-terminal-400">
      Reach {TEMPLATE.identity.name} ({TEMPLATE.identity.handle}), {TEMPLATE.identity.role} at {TEMPLATE.identity.org}.
    </p>

    <Panel title="~/mail/new" variant="double">
      <ContactForm variant="full" />
    </Panel>

    {
      socialItems.length > 0 && (
        <div class="mt-10">
          <Heading level={2} class="mb-3">
            Elsewhere
          </Heading>
          <KeyValue items={socialItems} />
        </div>
      )
    }
  </Container>
</PageLayout>
