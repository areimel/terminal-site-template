---
/**
 * MarkdownLayout - the layout `.md` pages opt into via `layout: '~/layouts/MarkdownLayout.astro'`
 * in their frontmatter (see `privacy.md` / `terms.md`). Astro passes the whole frontmatter object
 * as the `frontmatter` prop.
 */
import Layout from '~/layouts/PageLayout.astro';
import { Container, Heading } from '~/components/core';
import { Prose } from '~/components/content';

import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
  };
}

const { frontmatter } = Astro.props;

const metadata: MetaData = {
  title: frontmatter?.title,
};
---

<Layout metadata={metadata}>
  <Container size="prose" spacing="lg">
    <Heading level={1} class="mb-6">
      {frontmatter.title}
    </Heading>
    <Prose>
      <slot />
    </Prose>
  </Container>
</Layout>
