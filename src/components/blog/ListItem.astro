---
/**
 * ListItem - shared list-row card for both blog posts and projects, built on core `Panel`.
 * Renders as a `<li>` (Panel's `as` prop) so it drops straight into a `<ul>`.
 */
import type { ImageMetadata } from 'astro';

import { Heading, Icon, Panel } from '~/components/core';
import PostTags from '~/components/blog/Tags.astro';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import { getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
  class?: string;
}

const { post, class: className } = Astro.props;

const rawImage = (await findImage(post.image)) as ImageMetadata | string | undefined;
const imageSrc = typeof rawImage === 'string' ? rawImage : rawImage?.src;

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<Panel as="li" variant="line" padding="md" class:list={className}>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
    {
      imageSrc && (
        <div class="w-full shrink-0 overflow-hidden border border-terminal-300/40 sm:w-40">
          {link ? (
            // aria-hidden + tabindex="-1": this image link is a visual duplicate of the
            // title link below (same href, same destination) with only an empty-alt image
            // inside, so it was a focusable link with no accessible name. Hiding it from
            // the a11y tree/tab order leaves exactly one way to reach the post.
            <a href={link} class="block" aria-hidden="true" tabindex="-1">
              <img src={imageSrc} alt="" loading="lazy" decoding="async" class="h-32 w-full object-cover sm:h-24" />
            </a>
          ) : (
            <img src={imageSrc} alt="" loading="lazy" decoding="async" class="h-32 w-full object-cover sm:h-24" />
          )}
        </div>
      )
    }

    <div class="min-w-0 flex-1">
      <div class="mb-1 flex flex-wrap items-center gap-x-2 gap-y-1 font-kode text-t-sm text-terminal-400">
        <Icon name="tabler:clock" size={14} />
        <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
        {
          post.category && (
            <>
              <span aria-hidden="true">·</span>
              <a
                href={post.category.permalink ?? getPermalink(post.category.slug, 'category')}
                class="transition-colors hover:text-terminal-bright"
              >
                {post.category.title}
              </a>
            </>
          )
        }
      </div>

      <Heading level={3} class="mb-2">
        {
          link ? (
            <a href={link} class="transition-colors hover:text-terminal-bright">
              {post.title}
            </a>
          ) : (
            post.title
          )
        }
      </Heading>

      {post.excerpt && <p class="text-terminal-400">{post.excerpt}</p>}

      {post.tags && Array.isArray(post.tags) && post.tags.length > 0 && <PostTags tags={post.tags} class="mt-3" />}
    </div>
  </div>
</Panel>
