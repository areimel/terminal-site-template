---
// Component to control terminal effects visibility, backed by ~/lib/effects.ts.
import { Icon } from 'astro-icon/components';
import { effectNames } from '~/lib/effects';

const effectLabels: Record<(typeof effectNames)[number], string> = {
  boot: 'Boot Screen',
  noise: 'CRT Noise',
  scanline: 'Scanlines',
  overlay: 'CRT Overlay',
  decoder: 'Decoder Text',
};
---

<div class="terminal-effects-controls">
  <h3 class="text-terminal-500 text-lg font-bold mb-3">Terminal Effects</h3>

  <div class="flex flex-col gap-2">
    <div class="flex items-center px-4 py-2 bg-terminal-bg-secondary border-2 border-terminal-bright">
      <div class="custom-checkbox-container mr-3">
        <input type="checkbox" id="effect-all" class="effect-toggle sr-only" data-effect-all checked />
        <label
          for="effect-all"
          class="custom-checkbox flex items-center justify-center w-4 h-4 border border-terminal-400 bg-terminal-bg-secondary cursor-pointer transition-colors hover:border-terminal-500"
        >
          <Icon name="tabler:check" class="w-3 h-3 text-terminal-500 opacity-0 transition-opacity check-icon" />
        </label>
      </div>
      <label for="effect-all" class="text-terminal-bright font-uav-mono text-xs cursor-pointer select-none no-glow"
        >All effects</label
      >
    </div>

    {
      effectNames.map((name) => (
        <div class="flex items-center px-4 py-2 bg-terminal-bg-secondary border-2 border-terminal-300">
          <div class="custom-checkbox-container mr-3">
            <input type="checkbox" id={`effect-${name}`} class="effect-toggle sr-only" data-effect={name} checked />
            <label
              for={`effect-${name}`}
              class="custom-checkbox flex items-center justify-center w-4 h-4 border border-terminal-400 bg-terminal-bg-secondary cursor-pointer transition-colors hover:border-terminal-500"
            >
              <Icon name="tabler:check" class="w-3 h-3 text-terminal-500 opacity-0 transition-opacity check-icon" />
            </label>
          </div>
          <label
            for={`effect-${name}`}
            class="text-terminal-500 font-uav-mono text-xs cursor-pointer select-none no-glow"
          >
            {effectLabels[name]}
          </label>
        </div>
      ))
    }
  </div>
</div>

<script>
  import { effectNames, getEffects, setEffect, setAllEffects, type EffectsState } from '~/lib/effects';

  function updateCheckboxUI(checkbox: HTMLInputElement) {
    const checkIcon = checkbox.nextElementSibling?.querySelector('.check-icon');
    checkIcon?.classList.toggle('opacity-100', checkbox.checked);
    checkIcon?.classList.toggle('opacity-0', !checkbox.checked);
  }

  function render(state: EffectsState) {
    const allToggle = document.querySelector<HTMLInputElement>('[data-effect-all]');
    if (allToggle) {
      allToggle.checked = state.all;
      updateCheckboxUI(allToggle);
    }

    effectNames.forEach((name) => {
      const toggle = document.querySelector<HTMLInputElement>(`[data-effect="${name}"]`);
      if (!toggle) return;
      toggle.checked = state[name];
      toggle.disabled = !state.all;
      updateCheckboxUI(toggle);
    });
  }

  function setupTerminalEffectsControls() {
    render(getEffects());

    document.querySelectorAll<HTMLInputElement>('.terminal-effects-controls [data-effect-all]').forEach((toggle) => {
      toggle.addEventListener('change', () => {
        render(setAllEffects(toggle.checked));
      });
    });

    document.querySelectorAll<HTMLInputElement>('.terminal-effects-controls [data-effect]').forEach((toggle) => {
      toggle.addEventListener('change', () => {
        const name = toggle.getAttribute('data-effect') as (typeof effectNames)[number];
        render(setEffect(name, toggle.checked));
      });
    });
  }

  setupTerminalEffectsControls();
  document.addEventListener('astro:page-load', setupTerminalEffectsControls);
  document.addEventListener('terminal:effects-change', (event) => {
    render((event as CustomEvent<EffectsState>).detail);
  });
</script>

<style>
  /* Custom checkbox container */
  .custom-checkbox-container {
    position: relative;
    display: inline-block;
  }

  /* Custom checkbox appearance */
  .custom-checkbox {
    transition: all 0.2s ease-in-out;
  }

  /* Checked state */
  .effect-toggle:checked + .custom-checkbox {
    background-color: var(--terminal-bg-accent);
    border-color: var(--terminal-bright);
  }

  /* Focus state for accessibility */
  .effect-toggle:focus + .custom-checkbox {
    box-shadow: 0 0 0 2px var(--terminal-bright);
  }

  /* Disabled state (all effects off) */
  .effect-toggle:disabled + .custom-checkbox {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* Hover state */
  .custom-checkbox:hover {
    border-color: var(--terminal-500);
  }

  /* Explicitly disable glow effects */
  .no-glow {
    text-shadow: none !important;
    box-shadow: none !important;
    filter: none !important;
  }
</style>
