---
/**
 * Tabs - the WAI-ARIA tabs pattern, backed by a `<terminal-tabs>` custom element. Arrow keys move
 * focus between tabs and select immediately (automatic activation), matching how a highlighted
 * item in a terminal list usually behaves. Home/End jump to the first/last tab.
 *
 * Panel content is provided via named slots, one per tab id: `<div slot={tab.id}>...</div>`.
 * Slots are rendered server-side with `Astro.slots.render()` because Astro requires static
 * `<slot name>` values. Ids are prefixed per instance so several Tabs can share a page.
 */
export interface Props {
  tabs: { id: string; label: string }[];
  /** Initially selected tab id. Defaults to the first tab. */
  selected?: string;
  /** Accessible name for the tab list. */
  label?: string;
  class?: string;
}

const { tabs, selected, label = 'Tabs', class: className } = Astro.props;

const uid = `tabs-${Math.random().toString(36).slice(2, 8)}`;

const panels = await Promise.all(
  tabs.map(async (tab) => (Astro.slots.has(tab.id) ? await Astro.slots.render(tab.id) : ''))
);

const initial = selected && tabs.some((tab) => tab.id === selected) ? selected : tabs[0]?.id;
---

<terminal-tabs class:list={['terminal-tabs block', className]} data-selected={initial}>
  <div role="tablist" aria-label={label} class="tabs-list flex flex-wrap gap-1 font-kode text-sm">
    {
      tabs.map((tab) => {
        const isSelected = tab.id === initial;
        return (
          <button
            type="button"
            role="tab"
            id={`${uid}-tab-${tab.id}`}
            aria-controls={`${uid}-panel-${tab.id}`}
            aria-selected={isSelected ? 'true' : 'false'}
            tabindex={isSelected ? 0 : -1}
            data-tab-id={tab.id}
            class:list={[
              'tab-trigger px-1 text-terminal-400 transition-colors hover:text-terminal-bright',
              { 'is-selected': isSelected },
            ]}
          >
            <span aria-hidden="true">[</span>
            <span class="px-1">{tab.label}</span>
            <span aria-hidden="true">]</span>
          </button>
        );
      })
    }
  </div>

  {
    tabs.map((tab, index) => (
      <div
        role="tabpanel"
        id={`${uid}-panel-${tab.id}`}
        aria-labelledby={`${uid}-tab-${tab.id}`}
        data-panel-id={tab.id}
        hidden={tab.id !== initial}
        tabindex={0}
        class="tab-panel pt-3"
      >
        <Fragment set:html={panels[index]} />
      </div>
    ))
  }
</terminal-tabs>

<script>
  class TerminalTabs extends HTMLElement {
    private tabs: HTMLButtonElement[] = [];
    private panels: HTMLElement[] = [];

    connectedCallback(): void {
      this.tabs = Array.from(this.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      this.panels = Array.from(this.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

      this.tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          if (tab.dataset.tabId) this.select(tab.dataset.tabId, false);
        });
        tab.addEventListener('keydown', (event) => this.onKeydown(event, index));
      });
    }

    private onKeydown(event: KeyboardEvent, index: number): void {
      let target: number | null = null;
      switch (event.key) {
        case 'ArrowRight':
        case 'ArrowDown':
          target = (index + 1) % this.tabs.length;
          break;
        case 'ArrowLeft':
        case 'ArrowUp':
          target = (index - 1 + this.tabs.length) % this.tabs.length;
          break;
        case 'Home':
          target = 0;
          break;
        case 'End':
          target = this.tabs.length - 1;
          break;
        default:
          return;
      }
      event.preventDefault();
      const nextTab = target !== null ? this.tabs[target] : undefined;
      if (nextTab?.dataset.tabId) this.select(nextTab.dataset.tabId, true);
    }

    private select(id: string, focus: boolean): void {
      this.tabs.forEach((tab) => {
        const isSelected = tab.dataset.tabId === id;
        tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        tab.tabIndex = isSelected ? 0 : -1;
        if (isSelected && focus) tab.focus();
      });
      this.panels.forEach((panel) => {
        panel.hidden = panel.dataset.panelId !== id;
      });
      this.dataset.selected = id;
      this.dispatchEvent(new CustomEvent('terminal:tabs-change', { detail: { id }, bubbles: true }));
    }
  }

  if (!customElements.get('terminal-tabs')) {
    customElements.define('terminal-tabs', TerminalTabs);
  }
</script>

<style>
  .tab-trigger.is-selected {
    color: var(--terminal-bright);
    text-shadow: var(--theme-glow);
  }
</style>
