---
import { getCollection, render } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import Panel from '~/components/core/Panel.astro';
import Heading from '~/components/core/Heading.astro';
import type { MetaData } from '~/types';

const entries = (await getCollection('changelog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const rendered = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const metadata: MetaData = {
  title: 'Changelog',
  description: 'What shipped, release by release.',
};
---

<PageLayout metadata={metadata}>
  <div class="mx-auto max-w-3xl px-4 py-12 lg:px-8 lg:py-16">
    <Heading level={1} class="mb-8"> Changelog </Heading>

    <div class="space-y-8">
      {
        rendered.map(({ entry, Content }) => (
          <Panel
            title={`v${entry.data.version} (${dateFormatter.format(entry.data.date)})`}
            variant="line"
            padding="lg"
          >
            {entry.data.summary && <p class="mb-4 text-terminal-300">{entry.data.summary}</p>}
            <div class="prose prose-terminal max-w-[72ch]">
              <Content />
            </div>
          </Panel>
        ))
      }
    </div>
  </div>
</PageLayout>
