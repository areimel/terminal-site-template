---
/**
 * Prose - wraps long-form content (blog posts, docs, markdown pages) in the `prose-terminal`
 * typography styles configured in `tailwind.config.js`. Measure is capped at ~72ch regardless of
 * `size`.
 *
 * Also carries the CSS that makes Markdown's own fenced code blocks (rendered by Astro's
 * markdown pipeline, not `CodeBlock.astro`) look consistent with `CodeBlock`: a themed panel-like
 * `pre` and matching font/size. Token colors come from the global `--astro-code-*` mapping in
 * `common/ThemeHead.astro` (Shiki runs with the `css-variables` theme).
 */
export interface Props {
  /** Tag to render the wrapper as. Defaults to `div`. */
  as?: string;
  /** Maps to the typography plugin's own size modifiers (`prose-sm` / `prose-lg`). */
  size?: 'sm' | 'base' | 'lg';
  class?: string;
}

const { as: Tag = 'div', size = 'base', class: className } = Astro.props;

const SIZE: Record<NonNullable<Props['size']>, string> = {
  sm: 'prose-sm',
  base: '',
  lg: 'prose-lg',
};
---

<Tag class:list={['prose prose-terminal max-w-[72ch]', SIZE[size], className]}>
  <slot />
</Tag>

<style>
  /* Structural consistency with `CodeBlock`: a themed, scrollable panel-like `pre`, regardless
     of which Shiki theme markdown rendering currently uses. */
  :global(.prose-terminal pre) {
    background: var(--theme-bg-secondary);
    border: 1px solid var(--theme-300);
    border-radius: 0;
    padding: 0.75rem 1rem;
    overflow-x: auto;
    font-family: 'Kode Mono', monospace;
    font-size: 0.8rem;
    line-height: 1.6;
  }

  :global(.prose-terminal pre:focus-visible) {
    outline: 2px solid var(--theme-bright);
    outline-offset: -2px;
  }

  :global(.prose-terminal pre code) {
    background: transparent;
    padding: 0;
    border-radius: 0;
    font-weight: 400;
  }
</style>

<script>
  /**
   * Markdown's own fenced code blocks are plain `<pre>` elements (no `CodeBlock` wrapper), so
   * they don't get `CodeBlock`'s tabindex/aria-label for keyboard-focusable scrolling for free.
   * This adds it, keyed off Shiki's `data-language` attribute. Idempotent and safe to re-run
   * after an Astro ClientRouter navigation.
   */
  function enhanceProseCode(prose: Element): void {
    prose.querySelectorAll<HTMLPreElement>('pre:not([tabindex])').forEach((pre) => {
      pre.setAttribute('tabindex', '0');
      pre.setAttribute('role', 'group');
      if (!pre.hasAttribute('aria-label')) {
        const lang = pre.dataset.language;
        pre.setAttribute('aria-label', lang ? `Code sample: ${lang}` : 'Code sample');
      }
    });
  }

  function enhanceAllProse(): void {
    document.querySelectorAll('.prose-terminal').forEach(enhanceProseCode);
  }

  enhanceAllProse();
  document.addEventListener('astro:page-load', enhanceAllProse);
</script>
