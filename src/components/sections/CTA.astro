---
/**
 * CTA - a single bordered strip: a title, optional description, and one or more actions.
 * Built on `Panel`'s `double` variant so it reads as an emphasized "app window" against the
 * quieter content around it.
 */
import Container from '~/components/core/Container.astro';
import Panel from '~/components/core/Panel.astro';
import Heading from '~/components/core/Heading.astro';
import Button from '~/components/core/Button.astro';
import type { SectionAction } from './types';

export interface Props {
  title: string;
  description?: string;
  actions: SectionAction[];
  /** Anchor id for the outer `<section>`. */
  id?: string;
  class?: string;
}

const { title, description, actions, id, class: className } = Astro.props;
---

<section id={id} class:list={['cta-section', className]}>
  <Container size="default" spacing="lg">
    <Panel variant="double" tone="accent" padding="lg">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex max-w-[56ch] flex-col gap-2">
          <Heading level={2}>{title}</Heading>
          {description && <p class="text-t-base text-terminal-400">{description}</p>}
        </div>
        <div class="flex flex-none flex-wrap gap-3">
          {
            actions.map((action) => (
              <Button href={action.href} variant={action.variant ?? 'solid'}>
                {action.label}
              </Button>
            ))
          }
        </div>
      </div>
    </Panel>
  </Container>
</section>
