---
/**
 * EffectsControls - a master "All effects" switch plus one switch per `effectNames` entry, backed
 * by `~/lib/effects`. Reflects state on load and on `terminal:effects-change`, and shows a note
 * when the OS's reduced-motion preference is forcing every effect off (the switches are disabled
 * in that state, since toggling them would have no visible effect).
 *
 * Switches are the shared `forms/Toggle` primitive.
 */
import { effectNames } from '~/lib/effects';
import Toggle from '~/components/forms/Toggle.astro';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const effectLabels: Record<(typeof effectNames)[number], string> = {
  boot: 'Boot screen',
  noise: 'CRT noise',
  scanline: 'Scanlines',
  overlay: 'CRT overlay',
  decoder: 'Decoder text',
};

const effectDescriptions: Record<(typeof effectNames)[number], string> = {
  boot: 'Plays the startup sequence once per visit.',
  noise: 'Adds a faint film-grain flicker over the page.',
  scanline: 'Overlays horizontal CRT scanlines.',
  overlay: 'Adds the CRT vignette and curvature overlay.',
  decoder: 'Animates headings and text marked for the decode effect.',
};
---

<div class:list={['effects-controls flex flex-col gap-3', className]}>
  <p
    role="status"
    data-reduced-motion-note
    hidden
    class="border border-terminal-300 bg-terminal-bg-secondary px-3 py-2 font-kode text-xs text-terminal-400"
  >
    Effects are off because your system has reduced motion enabled. Turn that off in your OS settings to re-enable them
    here.
  </p>

  <div class="effect-toggle-row border-2 border-terminal-bright bg-terminal-bg-secondary px-3 py-2">
    <Toggle
      name="effect-all"
      id="effect-all"
      label="All effects"
      description="Master switch for every effect below."
      checked
      data-effect-all
    />
  </div>

  {
    effectNames.map((name) => (
      <div class="effect-toggle-row border border-terminal-300 bg-terminal-bg-secondary px-3 py-2">
        <Toggle
          name={`effect-${name}`}
          id={`effect-${name}`}
          label={effectLabels[name]}
          description={effectDescriptions[name]}
          checked
          data-effect={name}
        />
      </div>
    ))
  }
</div>

<script>
  import { effectNames, getEffects, setEffect, setAllEffects, type EffectsState } from '~/lib/effects';

  function prefersReducedMotion(): boolean {
    try {
      return typeof window !== 'undefined' && !!window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    } catch {
      return false;
    }
  }

  function render(root: ParentNode, state: EffectsState): void {
    const reduced = prefersReducedMotion();

    const note = root.querySelector<HTMLElement>('[data-reduced-motion-note]');
    if (note) note.hidden = !reduced;

    const allToggle = root.querySelector<HTMLInputElement>('[data-effect-all]');
    if (allToggle) {
      allToggle.checked = state.all;
      allToggle.disabled = reduced;
    }

    effectNames.forEach((name) => {
      const toggle = root.querySelector<HTMLInputElement>(`[data-effect="${name}"]`);
      if (!toggle) return;
      toggle.checked = state[name];
      toggle.disabled = reduced || !state.all;
    });
  }

  function setup(): void {
    document.querySelectorAll<HTMLElement>('.effects-controls').forEach((controls) => {
      render(controls, getEffects());

      controls.querySelector<HTMLInputElement>('[data-effect-all]')?.addEventListener('change', (event) => {
        const checked = (event.target as HTMLInputElement).checked;
        render(controls, setAllEffects(checked));
      });

      effectNames.forEach((name) => {
        controls.querySelector<HTMLInputElement>(`[data-effect="${name}"]`)?.addEventListener('change', (event) => {
          const checked = (event.target as HTMLInputElement).checked;
          render(controls, setEffect(name, checked));
        });
      });
    });
  }

  setup();
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('terminal:effects-change', (event) => {
    const state = (event as CustomEvent<EffectsState>).detail;
    document.querySelectorAll<HTMLElement>('.effects-controls').forEach((controls) => render(controls, state));
  });
</script>
