---
import { Button, Icon } from '~/components/core';
import { getBlogPermalink } from '~/utils/permalinks';
import { I18N } from 'astrowind:config';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { textDirection } = I18N;
---

<div class:list={['mx-auto max-w-3xl px-4 py-8 sm:px-6', className]}>
  <Button href={getBlogPermalink()} variant="ghost" size="sm">
    <Icon name={textDirection === 'rtl' ? 'tabler:chevron-right' : 'tabler:chevron-left'} size={18} />
    Back to blog
  </Button>
</div>
